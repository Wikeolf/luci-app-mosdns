 func (d *DomainSet) GetDomainMatcher() domain.Matcher[struct{}] {
+	d.lock.RLock()
+	defer d.lock.RUnlock()
 	return MatcherGroup(d.mg)
 }
 
+// Len 返回域名集合中的域名数量总和
+func (d *DomainSet) Len() int {
+	d.lock.RLock()
+	defer d.lock.RUnlock()
+
+	total := 0
+	for _, m := range d.mg {
+		// 尝试获取匹配器的长度
+		if lenGetter, ok := m.(interface{ Len() int }); ok {
+			total += lenGetter.Len()
+		}
+	}
+	return total
+}
