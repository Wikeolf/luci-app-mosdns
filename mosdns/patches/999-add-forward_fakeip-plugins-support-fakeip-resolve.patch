+	d.lock.Lock()
+	defer d.lock.Unlock()
+
+	if err := LoadExps(exps, m); err != nil {
+		return err
+	}
+	if m.Len() > 0 {
+		d.mg = append(d.mg, m)
+	}
+	return nil
+}
